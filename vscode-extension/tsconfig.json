{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    "types": [
      "node",
      "vscode",
      "mocha",
      "jest"
    ]
  },
  "include": [
    "src/extension.ts"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out",
    "webview-src",
    "webview-dist",
    "src/test/**/*",
    "src/tests/**/*",
    "tests/**/*"
  ]
}

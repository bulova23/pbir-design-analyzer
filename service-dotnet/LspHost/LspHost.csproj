<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>ModelingLanguageServer</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>embedded</DebugType>
    <SelfContained>false</SelfContained>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Services/PbirProjectService.cs" Link="Imported/Services/PbirProjectService.cs" />
    <Compile Include="../Services/PbirTreeBuilder.cs" Link="Imported/Services/PbirTreeBuilder.cs" />
    <Compile Include="../Services/Pbir/**/*.cs"
             Exclude="../Services/Pbir/PbirCreationService.cs;../Services/Pbir/PbirThemeService.cs;../Services/Pbir/PbirLayoutPatternLibrary.cs;../Services/Pbir/Models/ThemeDefinition.cs;../Services/Pbir/Models/WizardState.cs;../Services/Pbir/Models/LayoutPattern.cs;../Services/Pbir/Models/ReportIntent.cs;../Services/Pbir/Models/ReportPage.cs"
             LinkBase="Imported/Services/Pbir" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
  </ItemGroup>

</Project>
